<section class="item-body">
  <section class="panel">
    <div class="item-grid">
      <div class="field">
        <label>Category</label>
        <select name="system.category">{{selectOptions modCategories selected=system.category}}</select>
      </div>
      <div class="field">
        <label>Armor Location</label>
        <select name="system.location">{{selectOptions modLocations selected=system.location}}</select>
      </div>
      {{#unless (eq system.location "none")}}
      <div class="field">
        <label>A.R.</label>
        <input type="number" name="system.ar" value="{{system.ar}}" min="0" />
      </div>
      <div class="field">
        <label>S.D.C.</label>
        <input type="number" name="system.sdc" value="{{system.sdc}}" min="0" />
      </div>
      {{/unless}}
      <div class="field">
        <label data-tooltip="e.g. Ram-Prow +75">Extra Vehicle S.D.C.</label>
        <input type="number" name="system.sdcBonus" value="{{system.sdcBonus}}" />
      </div>
      <div class="field">
        <label data-tooltip="e.g. Vehicle Active Suspension +15">Control Roll Bonus %</label>
        <input type="number" name="system.controlBonus" value="{{system.controlBonus}}" />
      </div>
      <div class="field">
        <label>Speed</label>
        <input type="text" name="system.speed" value="{{system.speed}}" placeholder="Speed Class 5 (hover)" />
      </div>
      <div class="field">
        <label>Effect (summary)</label>
        <input type="text" name="system.effect" value="{{system.effect}}" />
      </div>
      <div class="field">
        <label>Weight</label>
        <input type="text" name="system.weight" value="{{system.weight}}" />
      </div>
      <div class="field">
        <label>Cost</label>
        <input type="text" name="system.cost" value="{{system.cost}}" />
      </div>
    </div>
    <p class="hint">Armor with a location installs itself when dropped on a vehicle or time machine (sets that location's A.R. and S.D.C.). Only one set of armor per location.</p>
  </section>
  {{> "systems/palladium-universal/templates/item/parts/description.hbs"}}
</section>
