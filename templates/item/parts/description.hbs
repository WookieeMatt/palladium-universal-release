<section class="panel">
  <div class="panel-header"><h2>Description</h2></div>
  <prose-mirror name="system.description" value="{{system.description}}" toggled="true">{{{enrichedDescription}}}</prose-mirror>
  <div class="field item-roll-field">
    <label data-tooltip="The item's main roll, offered first by its roll button on the character sheet. Dice written in the description are offered too.">Roll</label>
    <div class="pair">
      <input type="text" name="system.itemRoll.formula" value="{{system.itemRoll.formula}}" placeholder="e.g. 1D6 or 2D6+6" />
      <input type="text" name="system.itemRoll.label" value="{{system.itemRoll.label}}" placeholder="Label, e.g. Duration (melees)" />
    </div>
  </div>
  <div class="field source-field">
    <label>Source</label>
    <input type="text" name="system.source" value="{{system.source}}" placeholder="TMNT p.60" />
  </div>
</section>
