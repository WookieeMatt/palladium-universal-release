<section class="tab sheet-body {{tab.cssClass}}" data-group="primary" data-tab="gear">
  {{#if money}}
  <section class="panel pu-money">
    <div class="panel-header"><h2>Money</h2>{{#if money.over}}<span class="pu-money-over"><i class="fa-solid fa-triangle-exclamation"></i> Over starting money by {{money.left}}</span>{{/if}}</div>
    <div class="pu-money-grid">
      <div class="field">
        <label>Starting Money ($)</label>
        <input type="number" name="system.money.starting" value="{{money.starting}}" min="0" step="1"
          data-tooltip="What the Origin and Education give (p.64): roll their money below and enter the total." />
      </div>
      <div class="field">
        <label>Spent on Items</label>
        <span class="pu-box" data-tooltip="{{money.itemsTooltip}}">{{money.items}}</span>
      </div>
      <div class="field">
        <label>Other Expenses ($)</label>
        <input type="number" name="system.money.other" value="{{money.other}}" min="0" step="1" data-tooltip="Spending that isn't an item: ammo, repairs, bribes, rent..." />
      </div>
      <div class="field">
        <label>{{#if money.over}}Over By{{else}}Left{{/if}}</label>
        <span class="pu-box score{{#if money.over}} over{{/if}}" data-tooltip="Total spent: {{money.spent}}">{{money.left}}</span>
      </div>
    </div>
    {{#if money.sources.length}}
    <ul class="pu-money-sources">
      {{#each money.sources}}<li><strong>{{name}}:</strong> {{{html}}}</li>{{/each}}
    </ul>
    {{else if money.unset}}
    <p class="hint">Starting money comes from the Origin and Education (drop them on the Bio-E / Mutation tab to see their dice here).</p>
    {{/if}}
    <p class="hint">Items count at their listed cost × quantity; removing one gives the money back. Going over is allowed: you and the GM get a warning.</p>
  </section>
  {{/if}}
  <section class="panel">
    <div class="panel-header">
      <h2>Equipment</h2>
      <button type="button" class="icon-button" data-action="itemCreate" data-type="gear" data-tooltip="Add gear"><i class="fa-solid fa-plus"></i></button>
    </div>
    <ol class="item-list">
      {{#each items.gear}}
      <li class="item-row" data-item-id="{{id}}">
        <img src="{{img}}" alt="" class="item-icon" />
        <div class="item-name"><a data-action="itemEdit">{{name}}</a></div>
        {{> "systems/palladium-universal/templates/actor/parts/counter.hbs"}}
        {{> "systems/palladium-universal/templates/actor/parts/item-roll.hbs"}}
        <button type="button" class="icon-button" data-action="itemDelete" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></button>
      </li>
      {{else}}
      <li class="hint">No gear yet. Weapons and armor live on the Combat tab.</li>
      {{/each}}
    </ol>
  </section>

  <section class="panel">
    <div class="panel-header">
      <h2>Devices</h2>
      <button type="button" class="icon-button" data-action="itemCreate" data-type="device" data-tooltip="Add a device"><i class="fa-solid fa-plus"></i></button>
    </div>
    <ol class="item-list">
      {{#each items.devices}}
      <li class="item-row {{#unless charged}}unequipped{{/unless}}" data-item-id="{{id}}">
        <img src="{{img}}" alt="" class="item-icon" />
        <div class="item-name"><a data-action="itemEdit">{{name}}</a><span class="hint">{{type}}{{#if readout}} · +{{bonus}}%{{/if}}</span></div>
        {{#unless readout}}
        {{#if charged}}
        <button type="button" class="roll-button" data-action="operate"><i class="fa-solid fa-clock-rotate-left"></i> Operate</button>
        {{else}}
        <button type="button" class="roll-button" data-action="recharge" data-tooltip="{{recharge}}"><i class="fa-solid fa-battery-half"></i> Recharge</button>
        {{/if}}
        {{/unless}}
        {{> "systems/palladium-universal/templates/actor/parts/item-roll.hbs"}}
        <button type="button" class="icon-button" data-action="itemDelete" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></button>
      </li>
      {{else}}
      <li class="hint">No time machines, cross-dimensional devices or readouts.</li>
      {{/each}}
    </ol>
  </section>

  <section class="panel">
    <div class="panel-header"><h2>Notes</h2></div>
    <div class="large-entry-box">
      <label>Money / other possessions</label>
      <prose-mirror name="system.gear" value="{{system.gear}}" toggled="true">{{{enriched.gear}}}</prose-mirror>
    </div>
    <div class="large-entry-box">
      <label>Character notes</label>
      <prose-mirror name="system.notes" value="{{system.notes}}" toggled="true">{{{enriched.notes}}}</prose-mirror>
    </div>
  </section>
</section>
