<section class="tab sheet-body {{tab.cssClass}}" data-group="primary" data-tab="core">
  {{#if checklist}}
  <section class="panel pu-checklist">
    <div class="panel-header">
      <h2>Creation Checklist</h2>
      <span class="hint">{{#if checklist.complete}}All done{{else}}{{checklist.done}} of {{checklist.total}} done{{/if}}</span>
      <button type="button" class="pu-checklist-hide" data-action="checklistToggle" data-tooltip="Hide the checklist. You can bring it back from the bottom of this tab."><i class="fa-solid fa-eye-slash"></i> Hide</button>
    </div>
    <ol class="pu-checklist-steps">
      {{#each checklist.steps}}
      <li class="{{#if done}}done{{else}}todo{{/if}}">
        <i class="fa-solid {{#if done}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
        {{#if done}}<span class="pu-step">{{label}}</span>
        {{else}}<a class="pu-step" data-action="checklistGo" data-tab="{{tab}}" data-tooltip="Go to the tab for this step">{{label}}</a>{{/if}}
        <span class="pu-step-detail">{{detail}}</span>
        <span class="pu-step-tools">{{#unless done}}
          {{#if compendium}}<button type="button" class="pu-step-tool" data-action="checklistCompendium" data-step="{{key}}" data-tooltip="{{compendium.hint}}" aria-label="Open the compendium"><i class="fa-solid fa-book-open"></i></button>{{/if}}
          {{#if roll}}<button type="button" class="pu-step-tool" data-action="creationRoll" data-table="{{roll}}" data-tooltip="Optional: roll it on the book's table. Click again to roll again." aria-label="Roll"><i class="fa-solid fa-dice"></i></button>{{/if}}
          {{#if action}}<button type="button" class="pu-step-tool" data-action="{{action}}" data-hp="roll" data-tooltip="{{actionHint}}" aria-label="Roll"><i class="fa-solid fa-dice"></i></button>{{/if}}
        {{/unless}}</span>
      </li>
      {{/each}}
    </ol>
    {{#if reset}}
    <div class="pu-reset-row">
      <button type="button" class="pu-reset-character" data-action="resetCharacter" data-tooltip="{{reset.hint}}" {{#unless reset.enabled}}disabled{{/unless}}>
        <i class="fa-solid fa-rotate-left"></i> Reset Character</button>
      <span class="hint">Start character creation over · {{reset.text}}</span>
    </div>
    {{/if}}
  </section>
  {{/if}}
  <section class="panel">
    <div class="panel-header">
      <h2>Attributes</h2>
      <span class="hint">Click an attribute to show it in chat.</span>
      {{#if generation}}<button type="button" class="pu-roll-attributes" data-action="rollAttributes"
        data-tooltip="{{generation.hint}}"><i class="fa-solid {{generation.icon}}"></i> {{generation.label}}</button>{{/if}}
    </div>
    <table class="attribute-table">
      <thead>
        <tr><th>Attribute</th><th data-tooltip="3D6, +1D6 on 16–18 (rolled once at character creation)">Rolled</th>
          <th data-tooltip="The animal, its purchased options and abilities / powers">Species</th><th data-tooltip="I.Q., P.S., P.E. and Spd only">Size</th>
          <th data-tooltip="P.S., P.P., P.E. and Spd only">Physical Skills</th><th>Modifier</th><th>Score</th></tr>
      </thead>
      <tbody>
        {{#each attributes}}
        <tr>
          <th scope="row"><a class="pu-rollable" data-action="printAttribute" data-key="{{key}}"
            data-tooltip="Show {{label}} in chat{{#if bonus}}: {{bonus}}{{/if}}">{{label}}</a></th>
          <td><span class="pu-box{{#unless rolled}} empty{{/unless}}" data-tooltip="Rolled at character creation; not editable">{{rolledText}}</span></td>
          <td class="derived">{{gen.species}}</td>
          <td class="derived">{{gen.size}}</td>
          <td class="derived">{{gen.physical}}</td>
          <td class="derived">{{gen.modifier}}</td>
          <td><span class="pu-box score{{#unless rolled}} empty{{/unless}}{{#if halved}} halved{{/if}}" data-tooltip="{{scoreTooltip}}{{#if bonus}} — {{bonus}}{{/if}}">{{total}}</span></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  <section class="panel">
    <div class="panel-header">
      <h2>Health &amp; Damage</h2>
      <button type="button" class="pu-roll-attributes pu-heal" data-action="restAndHeal" data-tooltip="Rest &amp; Heal (p.92): Hit Points by treatment and days, 5 S.D.C. per hour of rest"><i class="fa-solid fa-kit-medical"></i> Heal</button>
      {{#if hpRoll}}<button type="button" class="pu-roll-attributes pu-roll-hp{{#if hpRoll.locked}} locked{{/if}}{{#if hpRoll.levelUp}} level-up{{/if}}"
        data-action="rollHitPoints" data-hp="{{hpRoll.action}}" data-tooltip="{{hpRoll.hint}}"><i class="fa-solid {{hpRoll.icon}}"></i> {{hpRoll.label}}</button>{{/if}}
    </div>
    <div class="health-grid">
      <div class="field">
        <label>Hit Points</label>
        <div class="pair">
          <input type="number" name="system.health.hp.value" value="{{system.health.hp.value}}" />
          <span class="sep">/</span>
          {{#if system.health.hp.rolled}}
          <span class="pu-box score" data-tooltip="P.E. {{system.health.hp.pe}} + dice {{system.health.hp.diceTotal}} ({{#each system.health.hp.dice}}{{#if @index}}, {{/if}}{{this}}{{/each}}){{#if system.health.hp.bonus}} + HP Bonus {{system.health.hp.bonus}}{{/if}}">{{system.health.hp.max}}</span>
          {{else}}
          <input type="number" name="system.health.hp.max" value="{{system.health.hp.max}}" data-tooltip="P.E. + 1D6, +1D6 per level. Use Roll Hit Points, or type a max here." />
          {{/if}}
        </div>
      </div>
      {{#if system.health.hp.rolled}}
      <div class="field">
        <label>HP Bonus</label>
        <input type="number" name="system.health.hp.bonus" value="{{system.health.hp.bonus}}" data-tooltip="Added to max Hit Points (abilities, GM awards)" />
      </div>
      {{/if}}
      <div class="field">
        <label>S.D.C.</label>
        <div class="pair">
          <input type="number" name="system.health.sdc.value" value="{{system.health.sdc.value}}" />
          <span class="sep">/</span>
          <span class="derived">{{system.health.sdc.max}}</span>
        </div>
      </div>
      <div class="field">
        <label>S.D.C. Bonus <span class="hint">(size {{system.health.sdc.base}}{{#if system.health.sdc.doubled}} doubled{{/if}}, skills {{system.health.sdc.items}})</span></label>
        <input type="number" name="system.health.sdc.bonus" value="{{system.health.sdc.bonus}}" data-tooltip="Anything not tracked by items, e.g. Natural Armor S.D.C." />
      </div>
      <div class="field">
        <label>Natural Armor A.R. <span class="hint">(in use: {{system.health.naturalArmor.total}})</span></label>
        <input type="number" name="system.health.naturalArmor.ar" value="{{system.health.naturalArmor.ar}}" data-tooltip="Animal ability items with an A.R. override this if higher" />
      </div>
      {{#if system.health.armor.item}}
      <div class="field">
        <label>Body Armor (equipped item)</label>
        <span class="derived left">{{system.health.armor.active.name}}: A.R. {{system.health.armor.active.ar}}, S.D.C. {{system.health.armor.active.sdc.value}}/{{system.health.armor.active.sdc.max}}</span>
      </div>
      {{else}}
      <div class="field">
        <label>Body Armor</label>
        <input type="text" name="system.health.armor.name" value="{{system.health.armor.name}}" placeholder="None (or equip an armor item)" />
      </div>
      <div class="field">
        <label>Body Armor A.R.</label>
        <input type="number" name="system.health.armor.ar" value="{{system.health.armor.ar}}" />
      </div>
      <div class="field">
        <label>Body Armor S.D.C.</label>
        <div class="pair">
          <input type="number" name="system.health.armor.sdc.value" value="{{system.health.armor.sdc.value}}" />
          <span class="sep">/</span>
          <input type="number" name="system.health.armor.sdc.max" value="{{system.health.armor.sdc.max}}" />
        </div>
      </div>
      {{/if}}
    </div>
    {{#if system.health.armorBands.length}}
    <p class="pu-armor-layers" data-tooltip="{{#each system.health.armorBands}}{{range}}: {{label}}<br>{{/each}}4 or less always misses.">
      <i class="fa-solid fa-shield-halved"></i> Strikes: {{#each system.health.armorBands}}<span class="pu-band {{kind}}">{{range}}</span>{{/each}}
    </p>
    {{/if}}
    <p class="hint">
      Coma at 0 HP · dies below {{system.health.deathThreshold}} HP · survives a coma {{system.health.comaHours}} hours untreated.
      {{#if system.health.inComa}}<strong class="warning">In a coma!</strong>{{else if system.health.bleedingOut}}<strong class="warning">Bleeding out: 1 HP per minute until first aid.</strong>{{/if}}
    </p>
  </section>
  {{#if checklistRestore}}
  <p class="hint pu-checklist-restore"><a data-action="checklistToggle"><i class="fa-solid fa-list-check"></i> Show the creation checklist</a></p>
  {{/if}}
</section>
