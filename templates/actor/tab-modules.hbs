<section class="tab sheet-body {{tab.cssClass}}" data-group="primary" data-tab="modules">
  <section class="panel">
    <div class="panel-header">
      <h2>Module Toggles</h2>
    </div>
    <div class="toggle-grid">
      <label><input type="checkbox" name="system.toggles.useMdc" {{checked system.toggles.useMdc}} /> Use MDC</label>
      <label><input type="checkbox" name="system.toggles.useMagic" {{checked system.toggles.useMagic}} /> Magic</label>
      <label><input type="checkbox" name="system.toggles.usePsionics" {{checked system.toggles.usePsionics}} /> Psionics</label>
          <label><input type="checkbox" name="system.toggles.useSuperPowers" {{checked system.toggles.useSuperPowers}} /> Super Powers</label>
      <label><input type="checkbox" name="system.toggles.useMecha" {{checked system.toggles.useMecha}} /> Mecha / Vehicle</label>
      <label><input type="checkbox" name="system.toggles.useSurvivalHorror" {{checked system.toggles.useSurvivalHorror}} /> Survival / Horror</label>
    </div>
  </section>

  {{#if system.toggles.useMagic}}
  <section class="panel">
    <div class="panel-header">
      <h2>P.P.E. Magic (other Palladium settings)</h2>
    </div>
    <div class="module-grid">
      <div class="field">
        <label>PPE Current</label>
        <input type="number" name="system.magic.ppe.value" value="{{system.magic.ppe.value}}" />
      </div>
      <div class="field">
        <label>PPE Max</label>
        <input type="number" name="system.magic.ppe.max" value="{{system.magic.ppe.max}}" />
      </div>
      <div class="field">
        <label>Spell Strength</label>
        <input type="text" name="system.magic.spellStrength" value="{{system.magic.spellStrength}}" />
      </div>
      <div class="large-entry-box">
        <label>Spells</label>
        <prose-mirror name="system.magic.spells" value="{{system.magic.spells}}" toggled="true">{{{enriched.magic_spells}}}</prose-mirror>
      </div>
    </div>
  </section>
  {{/if}}

  {{#if system.toggles.usePsionics}}
  <section class="panel">
    <div class="panel-header">
      <h2>Psionics</h2>
    </div>
    <div class="module-grid">
      <div class="field">
        <label>ISP Current</label>
        <input type="number" name="system.psionics.isp.value" value="{{system.psionics.isp.value}}" />
      </div>
      <div class="field">
        <label>ISP Max</label>
        <input type="number" name="system.psionics.isp.max" value="{{system.psionics.isp.max}}" />
      </div>
      <div class="large-entry-box">
        <label>Powers</label>
        <prose-mirror name="system.psionics.powers" value="{{system.psionics.powers}}" toggled="true">{{{enriched.psionics_powers}}}</prose-mirror>
      </div>
    </div>
  </section>
  {{/if}}


  {{#if system.toggles.useSuperPowers}}
  <section class="panel">
    <div class="panel-header">
      <h2>Super Powers</h2>
    </div>
    <div class="module-grid">
      <div class="field">
        <label>Category</label>
        <input type="text" name="system.superPowers.category" value="{{system.superPowers.category}}" />
      </div>
      <div class="large-entry-box">
        <label>Powers</label>
        <prose-mirror name="system.superPowers.powers" value="{{system.superPowers.powers}}" toggled="true">{{{enriched.superPowers_powers}}}</prose-mirror>
      </div>
      <div class="large-entry-box">
        <label>Weaknesses</label>
        <prose-mirror name="system.superPowers.weaknesses" value="{{system.superPowers.weaknesses}}" toggled="true">{{{enriched.superPowers_weaknesses}}}</prose-mirror>
      </div>
    </div>
  </section>
  {{/if}}

  {{#if system.toggles.useMecha}}
  <section class="panel">
    <div class="panel-header">
      <h2>Mecha / Vehicle</h2>
    </div>
    <div class="module-grid">
      <div class="field">
        <label>Name</label>
        <input type="text" name="system.mecha.name" value="{{system.mecha.name}}" />
      </div>
      <div class="field">
        <label>Speed</label>
        <input type="text" name="system.mecha.speed" value="{{system.mecha.speed}}" />
      </div>
      <div class="field">
        <label>Handling</label>
        <input type="text" name="system.mecha.handling" value="{{system.mecha.handling}}" />
      </div>
      <div class="large-entry-box">
        <label>MDC by Location</label>
        <prose-mirror name="system.mecha.mdcByLocation" value="{{system.mecha.mdcByLocation}}" toggled="true">{{{enriched.mecha_mdcByLocation}}}</prose-mirror>
      </div>
      <div class="large-entry-box">
        <label>Weapon Systems</label>
        <prose-mirror name="system.mecha.weaponSystems" value="{{system.mecha.weaponSystems}}" toggled="true">{{{enriched.mecha_weaponSystems}}}</prose-mirror>
      </div>
    </div>
  </section>
  {{/if}}

  {{#if system.toggles.useSurvivalHorror}}
  <section class="panel">
    <div class="panel-header">
      <h2>Survival / Horror</h2>
    </div>
    <div class="module-grid">
      <div class="field">
        <label>Infection Level</label>
        <input type="text" name="system.survival.infectionLevel" value="{{system.survival.infectionLevel}}" />
      </div>
      <div class="large-entry-box">
        <label>Supplies</label>
        <prose-mirror name="system.survival.supplies" value="{{system.survival.supplies}}" toggled="true">{{{enriched.survival_supplies}}}</prose-mirror>
      </div>
      <div class="large-entry-box">
        <label>Insanity / Effects</label>
        <prose-mirror name="system.survival.insanityEffects" value="{{system.survival.insanityEffects}}" toggled="true">{{{enriched.survival_insanityEffects}}}</prose-mirror>
      </div>
    </div>
  </section>
  {{/if}}
</section>
